# Copy this file to .deploy.env and fill in your Aliyun server settings.
# Do not commit .deploy.env.

ALIYUN_HOST=your-server-ip-or-domain
ALIYUN_USER=root
ALIYUN_PORT=22
ALIYUN_DEPLOY_PATH=/opt/mail

# Optional. Leave empty to use your default SSH key.
# Example: /Users/t/.ssh/ccbot_aliyun_deploy
ALIYUN_SSH_KEY=

# SQLite paths. Defaults match this project.
LOCAL_DB=db/mail.sqlite
REMOTE_DB=/opt/mail/db/mail.sqlite

# Optional remote commands.
REMOTE_STOP_COMMAND='systemctl stop mail-system 2>/dev/null || true'
REMOTE_RESTART_COMMAND='systemctl restart mail-system 2>/dev/null || (cd /opt/mail && ./restart.sh)'
REMOTE_CHOWN_COMMAND=
